# Local: DEBUG=True is common; omit or set DEBUG=False for production-like runs.
# SECRET_KEY: optional locally (defaults to unsafe-dev-key). Required on Render.
DJANGO_SECRET_KEY=change-me-use-long-random-string
DEBUG=True
# Comma-separated. Default in code is * if unset; restrict in production.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver,.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=http://127.0.0.1:8000
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
DATABASE_URL=

# Render production (set in dashboard; RENDER=true is automatic):
# DEBUG=False
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# SITE_URL=https://your-app.onrender.com
# DATABASE_URL=postgres://...
